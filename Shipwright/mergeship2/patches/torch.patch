+void Companion::SetResourceNamespace(const std::string& prefix) {
+    if (!prefix.empty() && prefix.find_first_not_of("abcdefghijklmnopqrstuvwxyz0123456789_") != std::string::npos) {
+        throw std::invalid_argument("Resource namespace must contain only lowercase letters, digits, or underscores");
+    }
+    gResourceNamespace = prefix;
+}
+
+std::string Companion::NamespacePath(const std::string& path) const {
+    if (gResourceNamespace.empty() || path.empty() || path.starts_with(gResourceNamespace + "/")) {
+        return path;
+    }
+    return gResourceNamespace + "/" + path;
+}
