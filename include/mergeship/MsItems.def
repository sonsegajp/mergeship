/*
 * MergeShip2 -- the canonical item table of the unified randomizer (one seed over Hyrule and Termina).
 * Shipwright/mergeship2/docs/UNIFIED_RANDO_DESIGN.md, "Shared item model".
 *
 * An X-macro list: define the row macros you need, include this file, and it undefines them again. It has no
 * include guard on purpose. Consumers:
 *   - SoH:   soh/soh/MergeShip/MergeShipMsItems.cpp (the RandomizerGet side: lookup tables and static checks)
 *   - 2Ship: 2s2h/Rando/Types.h (the RI_OOT_* proxies in RandoItemId), 2s2h/Rando/StaticData/Items.cpp (their
 *            RandoStaticItem rows), 2s2h/Rando/MergeShip/MsItemsCheck.cpp (static checks)
 *   - tools/port_mm_rando.py (reads it to generate the RG_MM_* items SoH lacks and to check coverage)
 *
 * Rows
 *   MS_ITEM(key, rg, ri, kind, persist, oot, mm, maxLevel, name)
 *       An item both randomizers can name: SoH's RandomizerGet `rg` and 2Ship's RandoItemId `ri` are the same item.
 *   MS_ITEM_OOT(key, rg, kind, persist, oot, mm, maxLevel, name)
 *       An item 2Ship's randomizer has no RandoItemId for. Its RandoItemId is the proxy RI_OOT_<key>: when a
 *       Termina check holds it, 2Ship records it (for the host's shared inventory) instead of giving a native item.
 *   MS_ALIAS_RG(rg, key)
 *       Another SoH RandomizerGet for the item `key` (a shop "Buy" variant, or a MergeShip-mode MM item that is the
 *       same thing as an Ocarina of Time item in the unified model, e.g. RG_MM_HEROS_SHIELD = the Hylian Shield).
 *   MS_SKIP_RG(rg, why) / MS_SKIP_RI(ri, why)
 *       Enum values that are not items (logic-only values, placeholders, display markers).
 *   Every RandomizerGet but RG_MAX and every RandoItemId but RI_MAX appears exactly once as rg / ri of a row above
 *   (RI_OOT_* proxies aside). tools/port_mm_rando.py --check and the static_asserts on both sides enforce it.
 *
 * Columns
 *   key       canonical id: the RandomizerGet without its RG_ prefix (MsItemKey MSI_<key>)
 *   kind      MS_KIND_*: MAJOR, LESSER, JUNK, HEALTH, MASK, SONG, BOTTLE, SMALL_KEY, BOSS_KEY, DUNGEON_MAP, TOKEN,
 *             STRAY_FAIRY, SOUL, TRAP. 2Ship's RandoItemType follows from it (MsItems.h MS_KIND_TO_RITYPE).
 *   persist   MS_PERM:  owned in the shared inventory, kept across MM's three-day cycle.
 *             MS_CYCLE: a consumable (ammo, rupees, refills, bottle contents): not shared -- it goes to the engine
 *                       whose check gave it, and MM's Song of Time resets MM's count by MM's rules (Hyrule's counts
 *                       are untouched).
 *   oot, mm   1 when that engine can use the item: natively, or through the native item the host's projector
 *             gives for it (an OoT ocarina lets MM play). Logic counts an item in a world only where it is usable.
 *   maxLevel  copies that count (the progressive levels, 15 per stray fairy set, ...); further copies are
 *             redundant and the unified item pool turns them into junk. 0 = no limit (consumables, keys, hearts,
 *             bottles -- hearts and bottles have their own caps, see the design).
 *   name      English display name (2Ship shows it for a proxy).
 */
#ifndef MS_ITEM
#define MS_ITEM(key, rg, ri, kind, persist, oot, mm, maxLevel, name)
#define MS_ITEM_DEF_CLEANUP_ITEM
#endif
#ifndef MS_ITEM_OOT
#define MS_ITEM_OOT(key, rg, kind, persist, oot, mm, maxLevel, name)
#define MS_ITEM_DEF_CLEANUP_ITEM_OOT
#endif
#ifndef MS_ALIAS_RG
#define MS_ALIAS_RG(rg, key)
#define MS_ITEM_DEF_CLEANUP_ALIAS_RG
#endif
#ifndef MS_SKIP_RG
#define MS_SKIP_RG(rg, why)
#define MS_ITEM_DEF_CLEANUP_SKIP_RG
#endif
#ifndef MS_SKIP_RI
#define MS_SKIP_RI(ri, why)
#define MS_ITEM_DEF_CLEANUP_SKIP_RI
#endif

// clang-format off
/* ---- Items both randomizers know: SoH RandomizerGet <-> 2Ship RandoItemId ---- */
MS_ITEM(BRONZE_SCALE,                    RG_BRONZE_SCALE,                       RI_ABILITY_SWIM,               MS_KIND_MAJOR,       MS_PERM, 1, 1,   1, "Bronze Scale")
